# Supabase proje URL (Backend URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / publishable key (public API key)
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase service role key (admin yetkisi, sadece sunucu tarafında kullanılır)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tarayıcı tarafı (Vite build-time) için Supabase URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Tarayıcı tarafı için public key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Admin paneli secret giriş bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
